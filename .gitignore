# ── Live data — never commit ────────────────────────────────
# etazna.db holds personal data (имена, ЕГН, телефони) and changes on
# every run. Backups are handled by core.database.backup_db(), not git.
etazna.db
etazna.db-wal
etazna.db-shm
backups/
reports/generated/*.pdf

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── PyInstaller build output ────────────────────────────────
build/
dist/

# ── OS / tooling junk ───────────────────────────────────────
*.stackdump
Thumbs.db
.DS_Store

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json
